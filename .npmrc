node-options=--import data:text/javascript,%2F**%0A%20*%20Windows%20filesystem%20compatibility%20shim%20(loaded%20via%20%60.npmrc%60%20%60node-options%60).%0A%20*%0A%20*%20Upstream's%20ACP%20provider%20kills%20its%20child%20process%20and%20immediately%20removes%20the%0A%20*%20temporary%20working%20directory.%20On%20Windows%20the%20killed%20child%20still%20holds%20a%0A%20*%20handle%20to%20its%20cwd%20for%20a%20short%20moment%2C%20so%20%60fs.rm%60%20fails%20with%20EBUSY%3B%20upstream%0A%20*%20then%20reports%20that%20filesystem%20error%20instead%20of%20the%20real%20failure%20and%20leaves%0A%20*%20the%20temp%20directory%20behind.%20The%20tests%20in%20%60server%2Fproviders%2Fproviders.test.ts%60%0A%20*%20(and%20manual%20%60scripts%2Fcompare-reasoning.ts%60%20runs)%20hit%20exactly%20this.%0A%20*%0A%20*%20Retrying%20the%20removal%20is%20the%20fix%2C%20but%20it%20must%20not%20live%20in%20upstream's%20source%3A%0A%20*%20patching%20the%20builtin%20here%20keeps%20%60server%2Fproviders%2Fcodex.ts%60%20byte-identical%20to%0A%20*%20upstream%20while%20still%20giving%20Node's%20ESM%20import%20of%20%60node%3Afs%2Fpromises%60%20the%0A%20*%20retrying%20implementation%20(%60syncBuiltinESMExports%60%20refreshes%20the%20bindings).%0A%20*%0A%20*%20This%20file%20is%20local-only%20and%20has%20no%20effect%20on%20non-Windows%20platforms.%0A%20*%2F%0Aimport%20fs%20from%20'node%3Afs'%0Aimport%20fsPromises%20from%20'node%3Afs%2Fpromises'%0Aimport%20%7B%20syncBuiltinESMExports%20%7D%20from%20'node%3Amodule'%0Aimport%20%7B%20promisify%20%7D%20from%20'node%3Autil'%0A%0Aconst%20RETRYABLE%20%3D%20new%20Set(%5B'EBUSY'%2C%20'EPERM'%2C%20'ENOTEMPTY'%2C%20'EACCES'%5D)%0Aconst%20MAX_ATTEMPTS%20%3D%2020%0Aconst%20RETRY_DELAY_MS%20%3D%20100%0A%0Aif%20(process.platform%20%3D%3D%3D%20'win32')%20%7B%0A%20%20const%20retrying%20%3D%20(remove)%20%3D%3E%20async%20(target%2C%20options)%20%3D%3E%20%7B%0A%20%20%20%20for%20(let%20attempt%20%3D%200%3B%20%3B%20attempt%20%2B%3D%201)%20%7B%0A%20%20%20%20%20%20try%20%7B%0A%20%20%20%20%20%20%20%20return%20await%20remove(target%2C%20options)%0A%20%20%20%20%20%20%7D%20catch%20(error)%20%7B%0A%20%20%20%20%20%20%20%20const%20code%20%3D%20error%20%26%26%20typeof%20error%20%3D%3D%3D%20'object'%20%3F%20error.code%20%3A%20undefined%0A%20%20%20%20%20%20%20%20if%20(!RETRYABLE.has(code)%20%7C%7C%20attempt%20%3E%3D%20MAX_ATTEMPTS)%20throw%20error%0A%20%20%20%20%20%20%20%20await%20new%20Promise((resolve)%20%3D%3E%20setTimeout(resolve%2C%20RETRY_DELAY_MS))%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%7D%0A%0A%20%20const%20rmPromise%20%3D%20retrying(fsPromises.rm.bind(fsPromises))%0A%20%20fsPromises.rm%20%3D%20rmPromise%0A%0A%20%20const%20originalRm%20%3D%20fs.rm.bind(fs)%0A%20%20const%20rmCallback%20%3D%20promisify(originalRm)%0A%20%20fs.rm%20%3D%20function%20rmWithRetry(target%2C%20options%2C%20callback)%20%7B%0A%20%20%20%20if%20(typeof%20options%20%3D%3D%3D%20'function')%20%7B%0A%20%20%20%20%20%20callback%20%3D%20options%0A%20%20%20%20%20%20options%20%3D%20undefined%0A%20%20%20%20%7D%0A%20%20%20%20const%20result%20%3D%20rmCallback(target%2C%20options)%0A%20%20%20%20if%20(typeof%20callback%20%3D%3D%3D%20'function')%20%7B%0A%20%20%20%20%20%20result.then(%0A%20%20%20%20%20%20%20%20()%20%3D%3E%20callback(null)%2C%0A%20%20%20%20%20%20%20%20(error)%20%3D%3E%20callback(error)%2C%0A%20%20%20%20%20%20)%0A%20%20%20%20%20%20return%20undefined%0A%20%20%20%20%7D%0A%20%20%20%20return%20result%0A%20%20%7D%0A%0A%20%20syncBuiltinESMExports()%0A%7D%0A%0A
