# UOM Forge 服务端环境变量（仅服务端读取，绝不进入浏览器包）
# 复制为 .env 后按自己的端点填写。Vite 会加载项目根目录与上级 UOM 目录的 .env，
# 真实环境变量优先级最高。

# ── 默认推理提供方：codex | deepseek | private（private 亦可用 local / openai 别名）──
# UI 未手动切换时使用该值；UI 上的切换会覆盖它。
UOM_LLM_PROVIDER=private

# ── 私有模型（OpenAI 兼容 /chat/completions 端点，例如 vLLM、llama.cpp、自建网关）──
# base_url 可以写到 /v1，也可以写完整的 /v1/chat/completions，两者都支持。
PRIVATE_LLM_API_URL=http://127.0.0.1:8000/v1
PRIVATE_LLM_API_KEY=sk-123
PRIVATE_LLM_MODEL=qwen3.8-flash-next
# 可选：自定义 UI 上显示的提供方名称（默认自动显示「私有模型 · <model>」）
# PRIVATE_LLM_PROVIDER_LABEL=机房内网 Qwen

# ── DeepSeek（或任意其它 OpenAI 兼容服务）：private 未设置时会回退读取这三项 ──
# LLM_API_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# ── 超时（毫秒）：本地大模型推理较慢时可放宽，默认 300000（5 分钟）──
LLM_API_TIMEOUT_MS=900000

# ── 输出 token 上限（可选）：部分端点（如 DeepSeek）默认只有几千 token，
# 大模型 JSON 会被截断导致“不是有效的模型 JSON”。设置后请求会带上 max_tokens；
# 不设置则不发送该字段（由端点决定）。取值需小于模型上下文减去提示词长度。
# LLM_MAX_OUTPUT_TOKENS=32768

# ── 本轮正文上限（字符）：默认 120000。超限直接拒绝，从不截断正文 ──
# 截断会制造“某概念无原文依据”这种无法分辨真假的现象，所以宁可显式报错。
# 调高前请估算：prompt tokens ≈ 正文字符数 × 1.25（块 JSON 包装），余量要留给输出。
UOM_MAX_DOC_CHARS=140000

# Codex ACP 单次分析超时（毫秒），默认 300000
# CODEX_ACP_TIMEOUT_MS=600000
# Codex 推理强度：minimal | low | medium | high
# CODEX_REASONING_EFFORT=medium
# 自定义 Codex 在 UI 上的显示名
# UOM_CODEX_LABEL=Codex ACP
