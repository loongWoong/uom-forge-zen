# UOM Forge 服务端环境变量（仅服务端读取，绝不进入浏览器包）
# 复制为 .env 后按自己的端点填写。Vite 会加载项目根目录与上级 UOM 目录的 .env，
# 真实环境变量优先级最高。

# ── 默认推理提供方：deepseek | gpt ──
# 这是服务端与命令行脚本的默认值；页面每次加载都从 DeepSeek + Pi 运行时开始，
# 请求里显式指定的 provider 优先于该变量。
UOM_LLM_PROVIDER=gpt

# ── 默认 Agent 运行时：direct | pi ──
# 页面在“运行时”里手动切换；服务端请求未指定 runtime 时使用该值，默认 direct。
# UOM_AGENT_RUNTIME=pi
# Pi 阶段总超时（毫秒），默认 300000
# UOM_PI_TIMEOUT_MS=300000

# ── DeepSeek（或任意 OpenAI 兼容 /chat/completions 端点）──
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 超时（毫秒）：本地/慢端点可放宽，默认 300000（5 分钟）
LLM_API_TIMEOUT_MS=300000
# 输出 token 上限：默认 16384，请求始终携带 max_tokens。部分端点默认只有几千
# token，大 JSON 会被截断导致“不是有效的 JSON”；按模型上下文减去提示词长度调高。
# 取值必须为正整数，否则请求直接报错。
# LLM_MAX_OUTPUT_TOKENS=32768

# ── GPT（OpenAI 兼容 /chat/completions 端点）──
GPT_API_URL=
GPT_API_KEY=
GPT_MODEL=gpt-6-astra
# 推理强度：minimal | low | medium | high | xhigh（默认 medium）
# GPT_REASONING_EFFORT=medium
# 超时（毫秒），默认 300000；与 LLM_API_TIMEOUT_MS 相互独立
# GPT_API_TIMEOUT_MS=300000

# ── Codex ACP（已停用）──
# 应用提供方入口不再接受 codex，页面也不再提供该选项；
# 适配器与以下变量仅供 scripts/compare-reasoning.ts 手动实验使用。
# CODEX_ACP_TIMEOUT_MS=600000
# CODEX_REASONING_EFFORT=medium
# CODEX_MODEL=gpt-6-astra

# ── 本轮正文上限（字符）：默认 120000。超限直接拒绝，从不截断正文 ──
# 截断会制造“某概念无原文依据”这种无法分辨真假的现象，所以宁可显式报错。
# 调高前请估算：prompt tokens ≈ 正文字符数 × 1.25（块 JSON 包装），余量要留给输出。
# UOM_MAX_DOC_CHARS=140000
