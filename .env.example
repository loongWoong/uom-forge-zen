# UOM Forge 服务端环境变量（仅服务端读取，绝不进入浏览器包）
# 复制为 .env 后按自己的端点填写。overlay 启动时从项目根目录和上级 UOM 目录
# 依次加载 .env（真实环境变量优先级最高，其次项目 .env，最后上级 .env）；
# 修改 .env 后 Vite 重新加载配置时会先清掉上次注入的键再重新读取，无需重启进程。
# 直接使用上游原版（npm run dev）时只读取项目根目录的 .env，且不会清理旧值。

# ── 默认推理提供方：deepseek | gpt | qwen ──
# 这是服务端与命令行脚本的默认值；页面每次加载都从 DeepSeek + Pi 运行时开始，
# 请求里显式指定的 provider 优先于该变量。
UOM_LLM_PROVIDER=deepseek

# ── 默认 Agent 运行时：direct | pi ──
# 页面在“运行时”里手动切换（默认 Pi）；服务端请求未指定 runtime 时使用该值。
# UOM_AGENT_RUNTIME=pi
# Pi 阶段总超时（毫秒）。上游 piSignal 只读这一个变量，未设置时硬编码 300000（5 分钟）；
# overlay 会在启动时把它补成各 provider *_API_TIMEOUT_MS 的最大值，使 Pi 阶段与 direct
# 一样尊重慢端点的超时（显式设置本变量则完全以此为准，启动日志会打印实际取值）。
# UOM_PI_TIMEOUT_MS=900000
# 模型列表（/v1/models）的等待上限（毫秒），默认 10000。只影响顶栏选择器拉列表，
# 不影响推理请求；网关只接连接不回话时到点报错，不会让选择器一直转圈。
# UOM_MODELS_TIMEOUT_MS=10000
# 注：旧本地分支的 UOM_PI_FALLBACK=direct（Pi 首轮失败后用 direct 重跑）未在 overlay
# 中实现；Pi 首轮失败现在会直接暴露提供方的真实 HTTP 错误原因。

# ── Pi Agent 端点兼容（作用于 Pi JSON 修复 Agent；自定义/私有端点按需开启）──
# 最小化网关不支持 stream_options / tools.strict / store 或 thinking 字段时，
# 用 generic 一次性关闭这些厂商扩展；单项开关优先于 generic。
# UOM_PI_COMPAT=generic
# UOM_PI_STREAM_OPTIONS=false   # 不发送 stream_options.include_usage
# UOM_PI_STRICT=false           # 工具定义不发送 strict
# UOM_PI_STORE=false            # 不发送 store
# UOM_PI_MAX_TOKENS_FIELD=max_tokens
# UOM_PI_MAX_TOKENS=16384       # Pi 输出上限；默认=提供方上限（DeepSeek/Qwen）或 24000
# UOM_PI_CONTEXT_WINDOW=128000  # Pi 声明的上下文窗口
# UOM_PI_DISABLE_THINKING=true  # 是否发送 thinking:{type:'disabled'}（DeepSeek 默认开）
# UOM_PI_REASONING_EFFORT=medium # GPT 默认；off 表示不发送

# ── DeepSeek（或任意 OpenAI 兼容 /chat/completions 端点）──
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 超时（毫秒）：本地/慢端点可放宽，默认 300000（5 分钟）
LLM_API_TIMEOUT_MS=300000
# 输出 token 上限：默认 16384，请求始终携带 max_tokens；Pi JSON 修复阶段也读取该值。
# 部分端点默认只有几千 token，大 JSON 会被截断导致“不是有效的 JSON”；
# 按模型上下文减去提示词长度调高。取值必须为正整数，否则请求直接报错。
# LLM_MAX_OUTPUT_TOKENS=32768

# ── GPT（OpenAI 兼容 /chat/completions 端点）──
# 留空时自动复用上面的 LLM_* 通用通道（URL/KEY/MODEL/超时/输出上限），
# 这样单网关部署下 GPT/Qwen 的模型列表和请求都指向同一个 baseURL；
# 显式填写则完全以这里为准。整体关闭回退：UOM_PROVIDER_FALLBACK=off
GPT_API_URL=
GPT_API_KEY=
GPT_MODEL=gpt-6-astra
# 推理强度：minimal | low | medium | high | xhigh（默认 medium）
# GPT_REASONING_EFFORT=medium
# 超时（毫秒），默认 300000；与 LLM_API_TIMEOUT_MS 相互独立
# GPT_API_TIMEOUT_MS=300000
# 输出 token 上限（可选）：设置后 direct/Pi JSON 修复阶段都会携带 max_tokens；不设置则不发送
# GPT_MAX_OUTPUT_TOKENS=32768

# ── Qwen（OpenAI 兼容 /chat/completions 端点）──
# 同 GPT：留空则复用 LLM_* 通用通道
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen3.6
# 超时（毫秒），默认 300000；与 LLM/GPT 的超时相互独立
# QWEN_API_TIMEOUT_MS=300000
# 输出 token 上限：默认 16384，请求始终携带 max_tokens；不发送任何厂商推理参数
# QWEN_MAX_OUTPUT_TOKENS=32768

# ── Codex ACP（已停用）──
# 应用提供方入口不再接受 codex，页面也不再提供该选项；
# 适配器与以下变量仅供 scripts/compare-reasoning.ts 手动实验使用。
# CODEX_ACP_TIMEOUT_MS=600000
# CODEX_REASONING_EFFORT=medium
# CODEX_MODEL=gpt-6-astra

# ── 本轮正文上限（字符）：默认 120000。超限直接拒绝，从不截断正文 ──
# 截断会制造"某概念无原文依据"这种无法分辨真假的现象，所以宁可显式报错。
# overlay 会在请求进入上游前按该值校验并给出可读报错；注意上游自身的硬上限
# 仍是 120000，设置更大的值不会放宽。调高前请估算：prompt tokens ≈ 正文字符数
# × 1.25（块 JSON 包装），余量要留给输出。
# UOM_MAX_DOC_CHARS=100000
